<Window x:Class="AnimalQuiz.WPF.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnimalQuiz - Joc"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7D6">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF8C42"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#24527A"/>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Background="#B8E986"
                CornerRadius="25"
                Padding="18"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="🐾 Ghicește animalul!"
                           FontSize="38"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#24527A"/>

                <TextBlock x:Name="txtScore"
                           Text="Scor: 0"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#24527A"
                           HorizontalAlignment="Right"
                           Margin="0,10,20,10"/>

            </StackPanel>

        </Border>


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

            <Button Content="🔊 Redă sunet"
                    Width="220"
                    Height="60"
                    Background="#4DA3FF"
                    Click="BtnPlaySound_Click"/>

            <TextBlock Text="Ascultă sunetul și alege animalul corect!"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>

        </StackPanel>


        <UniformGrid Grid.Row="2"
                     Columns="3"
                     Margin="0,10,0,10">


            <Button Click="Answer1_Click"
                    Background="#FFB703">

                <Border Background="White"
                        CornerRadius="20"
                        Padding="10">

                    <Image x:Name="imgAnswer1"
                           Stretch="UniformToFill"/>

                </Border>

            </Button>


            <Button Click="Answer2_Click"
                    Background="#90BE6D">

                <Border Background="White"
                        CornerRadius="20"
                        Padding="10">

                    <Image x:Name="imgAnswer2"
                           Stretch="UniformToFill"/>

                </Border>

            </Button>


            <Button Click="Answer3_Click"
                    Background="#F28482">

                <Border Background="White"
                        CornerRadius="20"
                        Padding="10">

                    <Image x:Name="imgAnswer3"
                           Stretch="UniformToFill"/>

                </Border>

            </Button>

        </UniformGrid>


        <Border Grid.Row="3"
                Background="White"
                CornerRadius="20"
                Padding="15"
                Margin="0,15,0,0">

            <TextBlock Text="Alege imaginea care se potrivește cu sunetul."
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#444"/>

        </Border>


        <Border x:Name="resultBox"
                Grid.RowSpan="4"
                Background="#DDFFFFFF"
                Visibility="Collapsed"
                CornerRadius="30"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Height="250">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtResult"
                           Text="BRAVO!"
                           FontSize="52"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="Continuă"
                        Width="180"
                        Height="50"
                        Background="#4CAF50"
                        Click="BtnCloseResult_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>